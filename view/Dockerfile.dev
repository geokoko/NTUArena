# Node 22 Alpine — matches Dockerfile.prod. Node 18 or older breaks
# serialize-javascript@7 (pinned via overrides), which needs globalThis.crypto.
FROM node:22-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Expose port
EXPOSE 3000

# Start the app in development mode
CMD ["npm", "start"] 